/*搜索用户成功*/
#searchContactSuccessedDialog{
   background-color: #ffffff;
}

#name_label{
    font-size: 20px;
    font-family: "Microsoft YaHei";
}

searchContactSuccessedDialog #add_contact_btn[state='normal']{
    background: #07c160;
    color: #ffffff;
    font-size: 14px; /* 设置字体大小 */
    font-family: "Microsoft YaHei"; /* 设置字体 */
    border: 1px solid transparent;
    border-radius: 20px; /* 设置圆角 */
}

searchContactSuccessedDialog #add_contact_btn[state='hover']{
    background: #3bbb4b;
    color: #ffffff;
    font-size: 14px; /* 设置字体大小 */
    font-family: "Microsoft YaHei"; /* 设置字体 */
    border: 1px solid transparent;
    border-radius: 20px; /* 设置圆角 */
}

searchContactSuccessedDialog #add_contact_btn[state='pressed']{
   background: #05944a;
   color: #ffffff;
   font-size: 14px; /* 设置字体大小 */
   font-family: "Microsoft YaHei"; /* 设置字体 */
   border: 1px solid transparent;
   border-radius: 20px; /* 设置圆角 */
}

searchContactSuccessedDialog #cancel_btn[state='normal']{
    background: #07c160;
    color: #ffffff;
    font-size: 14px; /* 设置字体大小 */
    font-family: "Microsoft YaHei"; /* 设置字体 */
    border: 1px solid transparent;
    border-radius: 20px; /* 设置圆角 */
}

searchContactSuccessedDialog #cancel_btn[state='hover']{
    background: #3bbb4b;
    color: #ffffff;
    font-size: 14px; /* 设置字体大小 */
    font-family: "Microsoft YaHei"; /* 设置字体 */
    border: 1px solid transparent;
    border-radius: 20px; /* 设置圆角 */
}

searchContactSuccessedDialog #cancel_btn[state='pressed']{
   background: #05944a;
   color: #ffffff;
   font-size: 14px; /* 设置字体大小 */
   font-family: "Microsoft YaHei"; /* 设置字体 */
   border: 1px solid transparent;
   border-radius: 20px; /* 设置圆角 */
}


QDialog#FriendRequestDialog{
    border: 2px solid #f1f1f1;
