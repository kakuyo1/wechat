/*好友申请页面*/
#FR_title_label {
    font-family: "Microsoft YaHei";
    font-size: 18px;
    font-weight: normal;
}
#FR_title_widget {
    background-color: #f1f2f3;
    border-bottom: 1px solid #ede9e7;
}
